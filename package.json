{
  "name": "iyf-quran",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "native:prebuild": "expo prebuild",
    "test": "jest --runInBand",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && expo export --platform ios",
    "audio:download": "python3 scripts/download_reciter.py",
    "audio:index": "python3 scripts/build_audio_index.py --verify-hashes",
    "audio:align:elevenlabs": "python3 scripts/align_with_elevenlabs.py",
    "audio:analyze-pilot": "python3 scripts/analyze_alignment_pilot.py",
    "audio:analyze-silence": "python3 scripts/analyze_silence_agreement.py",
    "audio:test-alignment": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "audio:validate": "python3 scripts/validate_timing_index.py",
    "audio:review": "python3 scripts/review_timings.py",
    "audio:publish": "python3 scripts/publish_timing_index.py",
    "verify": "npm run test && npm run audio:test-alignment && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@expo-google-fonts/amiri-quran": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.10",
    "expo-asset": "~57.0.5",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.7",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "js-sha256": "^0.11.1",
    "quran-meta": "^6.0.17",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
